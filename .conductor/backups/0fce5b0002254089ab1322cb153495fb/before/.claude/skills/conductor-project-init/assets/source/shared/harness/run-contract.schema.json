{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/engineering-workflow/run-contract.schema.json",
  "title": "Project task checkpoint contract",
  "description": "Project-owned manual task/checkpoint format. Structure validation is not authority, evidence truth, locking or a runtime.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0-draft"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_attempt_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "issue_url": {
          "type": "string",
          "format": "uri"
        },
        "kind": {
          "enum": [
            "implementation",
            "analytics",
            "independent_review",
            "investigation"
          ]
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "Backlog",
            "Ready",
            "In progress",
            "Review",
            "Done"
          ]
        },
        "execution_state": {
          "enum": [
            "Ready",
            "Running",
            "Waiting quota",
            "Blocked",
            "Needs approval",
            null
          ]
        },
        "acceptance": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "non_goals": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "conflict_keys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "project_record_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "issue_url",
        "kind",
        "objective",
        "status",
        "execution_state",
        "acceptance",
        "non_goals",
        "dependencies",
        "conflict_keys",
        "project_record_ref"
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository_url": {
          "type": "string",
          "format": "uri"
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "release": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "repository_url",
        "commit_sha",
        "release"
      ]
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assignment_mode": {
          "const": "manual"
        },
        "approved_by_ref": {
          "type": "string",
          "minLength": 1
        },
        "adapter": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "github_actor": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "assignment_mode",
        "approved_by_ref",
        "adapter",
        "model",
        "adapter_version",
        "session_id",
        "github_actor"
      ]
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host_alias": {
          "type": "string",
          "minLength": 1
        },
        "architecture": {
          "type": "string",
          "minLength": 1
        },
        "runtime_lock_ref": {
          "type": "string",
          "minLength": 1
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "host_alias",
        "architecture",
        "runtime_lock_ref",
        "capabilities"
      ]
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "approval_ref": {
          "type": "string",
          "minLength": 1
        },
        "allowed_actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allowed_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbidden_actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "approved_data_destinations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "currency": {
              "type": "string",
              "minLength": 1
            },
            "maximum_additional_spend": {
              "type": "number",
              "minimum": 0
            },
            "remaining_approved_spend": {
              "type": "number",
              "minimum": 0
            },
            "max_wall_minutes": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "currency",
            "maximum_additional_spend",
            "remaining_approved_spend",
            "max_wall_minutes"
          ]
        }
      },
      "required": [
        "approval_ref",
        "allowed_actions",
        "allowed_paths",
        "forbidden_actions",
        "approved_data_destinations",
        "budget"
      ]
    },
    "code": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "base_sha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "head_sha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "pr_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "working_tree": {
          "enum": [
            "clean",
            "dirty",
            "not_applicable"
          ]
        },
        "patch_artifact_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "repository_url",
        "base_sha",
        "head_sha",
        "branch",
        "pr_url",
        "working_tree",
        "patch_artifact_ref"
      ]
    },
    "data_snapshots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "as_of": {
            "type": "string",
            "format": "date-time"
          },
          "snapshot_uri": {
            "type": "string",
            "format": "uri"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "classification": {
            "enum": [
              "public",
              "internal",
              "confidential",
              "restricted"
            ]
          },
          "permitted_use_ref": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "source_id",
          "as_of",
          "snapshot_uri",
          "sha256",
          "classification",
          "permitted_use_ref"
        ]
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "uri": {
            "type": "string",
            "format": "uri"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "retention_until": {
            "type": "string",
            "format": "date"
          }
        },
        "required": [
          "kind",
          "uri",
          "sha256",
          "retention_until"
        ]
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "criterion": {
            "type": "string",
            "minLength": 1
          },
          "command_or_method": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "enum": [
              "passed",
              "failed",
              "not_run"
            ]
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "tested_identity": {
            "type": "string",
            "minLength": 1
          },
          "recorded_at": {
            "type": "string",
            "format": "date-time"
          },
          "evidence_ref": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "criterion",
          "command_or_method",
          "result",
          "exit_code",
          "tested_identity",
          "recorded_at",
          "evidence_ref"
        ]
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewed_identity": {
          "type": [
            "string",
            "null"
          ]
        },
        "verdict": {
          "enum": [
            "pending",
            "changes_requested",
            "accepted",
            "not_required"
          ]
        },
        "evidence_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "reviewer",
        "reviewed_identity",
        "verdict",
        "evidence_ref"
      ]
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "failed_approach_findings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "blocker": {
          "type": [
            "string",
            "null"
          ]
        },
        "required_approval": {
          "type": [
            "string",
            "null"
          ]
        },
        "next_eligible_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "exact_next_action": {
          "type": "string",
          "minLength": 1
        },
        "reporting_app": {
          "type": "string",
          "minLength": 1
        },
        "freshness": {
          "enum": [
            "current",
            "stale",
            "unknown"
          ]
        }
      },
      "required": [
        "recorded_at",
        "decisions",
        "failed_approach_findings",
        "blocker",
        "required_approval",
        "next_eligible_at",
        "exact_next_action",
        "reporting_app",
        "freshness"
      ]
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "attempt_id",
    "parent_attempt_id",
    "task",
    "policy",
    "ownership",
    "environment",
    "authority",
    "code",
    "data_snapshots",
    "artifacts",
    "verification",
    "review",
    "checkpoint"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "task": {
            "properties": {
              "status": {
                "const": "Done"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "task": {
            "properties": {
              "execution_state": {
                "const": null
              }
            }
          },
          "verification": {
            "minItems": 1
          },
          "review": {
            "properties": {
              "verdict": {
                "enum": [
                  "accepted",
                  "not_required"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
